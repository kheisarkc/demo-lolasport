# Copy to .env on the VPS only; generate independent random secrets there.
APP_NAME="Lola Sport Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DEMO-HOSTNAME
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_COOKIE=lola_hosted_demo_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=YOUR-DEMO-HOSTNAME
FRONTEND_URL=https://YOUR-DEMO-HOSTNAME
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
DEMO_DP_PERCENT=50
DEMO_HOLD_MINUTES=30
