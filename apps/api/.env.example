# Template konfigurasi lokal. APP_KEY dan password diisi otomatis saat setup.
APP_NAME="Lola Sport Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55433
DB_DATABASE=lola_demo
DB_USERNAME=lola
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=lola_demo_session
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:3001

DEMO_DP_PERCENT=50
DEMO_HOLD_MINUTES=30
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
